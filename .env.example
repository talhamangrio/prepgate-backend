# MongoDB connection string (Atlas or local)
MONGO_URI=your_mongodb_connection_string_here

# JWT secret used to sign auth tokens (use a long random string in prod)
JWT_SECRET=your_jwt_secret_here

# Port the Express server listens on (Vercel ignores this; used for local dev)
PORT=5000

# Admin portal credentials (env-based, not stored in DB)
ADMIN_EMAIL=admin@prepgate.com
ADMIN_PASSWORD=change_me_in_prod
